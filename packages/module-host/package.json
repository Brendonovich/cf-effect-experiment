{
  "name": "@macrograph/module-host",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ContentHash": "./src/ContentHash.ts",
    "./ModuleEvaluator": "./src/ModuleEvaluator.ts",
    "./ModuleRegistry": "./src/ModuleRegistry.ts",
    "./ModuleSources": "./src/ModuleSources.ts",
    "./ModuleState": "./src/ModuleState.ts",
    "./ModuleTrust": "./src/ModuleTrust.ts",
    "./ModuleUrls": "./src/ModuleUrls.ts",
    "./ModuleWatcher": "./src/ModuleWatcher.ts",
    "./Mounter": "./src/Mounter.ts",
    "./SharedLibraryTable": "./src/SharedLibraryTable.ts",
    "./VersionSelection": "./src/VersionSelection.ts",
    "./VmLoader": "./src/VmLoader.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "generate": "node scripts/generate-shared-libraries.ts"
  },
  "dependencies": {
    "@macrograph/module": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  }
}
