{
  "name": "@macrograph/module-obs",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Events": "./src/Events.ts",
    "./Deployment/WebSocket": "./src/Deployment/WebSocket.ts",
    "./Engine": "./src/Engine.ts",
    "./Settings": "./src/Settings.tsx",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "obs",
    "version": "0.1.0",
    "api": 1,
    "displayName": "OBS Studio",
    "description": "Control OBS Studio and react to its events over obs-websocket.",
    "entries": {
      "server": "./src/Deployment/WebSocket.ts",
      "ui": "./src/UI.ts"
    },
    "requires": [
      "crypto",
      "socket"
    ]
  }
}
