{
  "name": "@macrograph/module-opencode",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Client": "./src/Client.ts",
    "./Definition": "./src/Definition.ts",
    "./Deployment/Server": "./src/Deployment/Server.ts",
    "./Engine": "./src/Engine.ts",
    "./Engine/Server": "./src/Engine/Server.ts",
    "./Instance": "./src/Instance.ts",
    "./Settings": "./src/Settings.tsx",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@opencode/client": "2.0.27",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "solid-js": "2.0.0-rc.9",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "opencode",
    "version": "0.1.0",
    "api": 1,
    "displayName": "OpenCode",
    "description": "Generates model-agnostic text through OpenCode.",
    "entries": {
      "server": "./src/Deployment/Server.ts",
      "ui": "./src/UI.ts"
    },
    "node": [
      "child_process",
      "fs/promises",
      "os",
      "path"
    ]
  }
}
