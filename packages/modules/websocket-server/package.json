{
  "name": "@macrograph/module-websocket-server",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Deployment/Local": "./src/Deployment/Local.ts",
    "./Engine": "./src/Engine.ts",
    "./Listener": "./src/Listener.ts",
    "./Listener/Node": "./src/Listener/Node.ts",
    "./Settings": "./src/Settings.tsx",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@macrograph/core": "workspace:*",
    "@macrograph/execution": "workspace:*",
    "typescript": "^5.8",
    "vitest": "^4.1.0",
    "ws": "^8.18.3"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "websocket-server",
    "version": "0.1.0",
    "api": 1,
    "displayName": "WebSocket Server",
    "description": "Host a WebSocket server and exchange messages with clients.",
    "entries": {
      "server": "./src/Deployment/Local.ts",
      "ui": "./src/UI.ts"
    },
    "node": [
      "buffer",
      "crypto",
      "events",
      "http",
      "https",
      "net",
      "stream",
      "tls",
      "url",
      "util",
      "zlib"
    ]
  }
}
