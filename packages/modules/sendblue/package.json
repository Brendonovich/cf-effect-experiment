{
  "name": "@macrograph/module-sendblue",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Deployment/Webhook": "./src/Deployment/Webhook.ts",
    "./Engine": "./src/Engine.ts",
    "./Polling": "./src/Polling.ts",
    "./Settings": "./src/Settings.tsx",
    "./Webhook": "./src/Webhook.ts",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "sendblue",
    "version": "0.1.0",
    "api": 1,
    "displayName": "Sendblue",
    "description": "Send and receive iMessages and SMS with Sendblue.",
    "entries": {
      "server": "./src/Deployment.ts",
      "ui": "./src/UI.ts"
    },
    "requires": [
      "http-client"
    ]
  }
}
