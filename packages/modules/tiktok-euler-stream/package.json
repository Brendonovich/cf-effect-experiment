{
  "name": "@macrograph/module-tiktok-euler-stream",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Engine": "./src/Engine.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Settings": "./src/Settings.tsx",
    "./Transport": "./src/Transport.ts",
    "./Events": "./src/Events.ts",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "solid-js": "2.0.0-rc.9",
    "tiktok-live-api-sdk": "0.4.0-beta1",
    "tiktok-live-connector": "2.4.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "tiktok-euler-stream",
    "version": "0.1.0",
    "api": 1,
    "displayName": "TikTok (Euler Stream)",
    "description": "React to TikTok LIVE events through Euler Stream.",
    "entries": {
      "server": "./src/Deployment.ts",
      "ui": "./src/UI.ts"
    },
    "node": [
      "assert",
      "buffer",
      "crypto",
      "diagnostics_channel",
      "dns",
      "events",
      "fs",
      "http",
      "http2",
      "https",
      "net",
      "os",
      "path",
      "process",
      "stream",
      "timers/promises",
      "tls",
      "tty",
      "url",
      "util",
      "zlib"
    ]
  }
}
