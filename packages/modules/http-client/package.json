{
  "name": "@macrograph/module-http-client",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Deployment/Local": "./src/Deployment/Local.ts",
    "./Engine": "./src/Engine.ts",
    "./UrlPolicy": "./src/UrlPolicy.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/module": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@macrograph/core": "workspace:*",
    "@macrograph/execution": "workspace:*",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "http-client",
    "version": "0.1.0",
    "api": 1,
    "displayName": "HTTP Client",
    "description": "Send HTTP requests and work with URLs.",
    "entries": {
      "server": "./src/Deployment/Local.ts"
    },
    "requires": [
      "http-client"
    ]
  }
}
