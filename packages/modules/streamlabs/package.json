{
  "name": "@macrograph/module-streamlabs",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Engine": "./src/Engine.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Settings": "./src/Settings.tsx",
    "./UI": "./src/UI.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@macrograph/editor-ui": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@solidjs/web": "2.0.0-rc.9",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "socket.io-client": "^4.8.1",
    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "streamlabs",
    "version": "0.1.0",
    "api": 1,
    "displayName": "Streamlabs",
    "description": "React to Streamlabs donations and alerts.",
    "entries": {
      "server": "./src/Deployment.ts",
      "ui": "./src/UI.ts"
    },
    "node": [
      "buffer",
      "child_process",
      "crypto",
      "events",
      "fs",
      "http",
      "https",
      "net",
      "os",
      "process",
      "stream",
      "tls",
      "tty",
      "url",
      "util",
      "zlib"
    ]
  }
}
