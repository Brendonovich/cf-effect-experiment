{
  "name": "@macrograph/module-shell",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/Module.ts",
  "exports": {
    ".": "./src/Module.ts",
    "./Definition": "./src/Definition.ts",
    "./Deployment": "./src/Deployment.ts",
    "./Engine": "./src/Engine.ts"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@macrograph/module": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "^5.8",
    "vitest": "^4.1.0"
  },
  "macrograph": {
    "publisher": "macrograph",
    "name": "shell",
    "version": "0.1.0",
    "api": 1,
    "displayName": "Shell",
    "description": "Run shell commands on the runtime host.",
    "entries": {
      "server": "./src/Deployment.ts"
    },
    "requires": [
      "file-system"
    ],
    "node": [
      "child_process",
      "stream"
    ]
  }
}
