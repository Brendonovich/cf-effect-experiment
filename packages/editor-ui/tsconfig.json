{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["@macrograph/icons/types"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["src", "test"],
