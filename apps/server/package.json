{
  "name": "@macrograph/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && pnpm --dir client build && pnpm build:backend",
    "build:backend": "rm -rf dist/esm && pnpm rolldown -c rolldown.config.ts && mkdir -p dist/esm/migrations && cp -R ../../packages/persistence-sqlite/drizzle/. dist/esm/migrations/",
    "typecheck": "tsgo --build",
    "start": "node --env-file-if-exists=.env dist/esm/index.js",
    "test": "vitest",
    "test:integration": "MACROGRAPH_BASE_PATH=/macrograph pnpm build && vitest run test/production.test.ts",
    "dev": "vite"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@macrograph/cloud-credentials": "workspace:*",
    "@macrograph/core": "workspace:*",
    "@macrograph/editor": "workspace:*",
    "@macrograph/execution": "workspace:*",
    "@macrograph/persistence": "workspace:*",
    "@macrograph/persistence-sqlite": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@macrograph/module-discord": "workspace:*",
    "@macrograph/module-elevenlabs": "workspace:*",
    "@macrograph/module-elgato-key-light": "workspace:*",
    "@macrograph/module-fs": "workspace:*",
    "@macrograph/module-goxlr": "workspace:*",
    "@macrograph/module-http-client": "workspace:*",
    "@macrograph/module-ikea-tradfri": "workspace:*",
    "@macrograph/module-json": "workspace:*",
    "@macrograph/module-lifx": "workspace:*",
    "@macrograph/module-list": "workspace:*",
    "@macrograph/module-logic": "workspace:*",
    "@macrograph/module-math": "workspace:*",
    "@macrograph/module-obs": "workspace:*",
    "@macrograph/module-openai": "workspace:*",
    "@macrograph/module-shell": "workspace:*",
    "@macrograph/module-speakerbot": "workspace:*",
    "@macrograph/module-streamdeck": "workspace:*",
    "@macrograph/module-streamlabs": "workspace:*",
    "@macrograph/module-string": "workspace:*",
    "@macrograph/module-tiktok-euler-stream": "workspace:*",
    "@macrograph/module-twitch": "workspace:*",
    "@macrograph/module-utilities": "workspace:*",
    "@macrograph/module-voicemod": "workspace:*",
    "@macrograph/module-vtube-studio": "workspace:*",
    "@macrograph/module-websocket-client": "workspace:*",
    "@macrograph/module-websocket-server": "workspace:*",
    "@macrograph/project-host": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@iconify/json": "2.2.196",
    "rolldown": "^1.0.1",
    "typescript": "^5.8",
    "vite": "^8.0.7",
    "vitest": "^4.1.0"
  }
}
