{
  "name": "cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy": "bun node_modules/alchemy/bin/alchemy.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "dev": "mprocs --names Alchemy,Frontend \"pnpm alchemy dev\" \"bun dev-tunnel.ts\"",
    "deploy": "pnpm alchemy deploy",
    "deploy:domain": "bun build src/worker/DomainGateway.ts --target browser --outfile .alchemy/domain-gateway/_worker.js && wrangler pages deploy --cwd domain-gateway --branch main",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@macrograph/cloud-api": "workspace:*",
    "@macrograph/cloud-credentials": "workspace:*",
    "@macrograph/core": "workspace:*",
    "@macrograph/editor": "workspace:*",
    "@macrograph/execution": "workspace:*",
    "@macrograph/http-ingress": "workspace:*",
    "@macrograph/persistence": "workspace:*",
    "@macrograph/persistence-sqlite": "workspace:*",
    "@macrograph/planetscale-logical-db": "workspace:*",
    "@macrograph/plugin": "workspace:*",
    "@macrograph/plugin-elevenlabs": "workspace:*",
    "@macrograph/plugin-http-client": "workspace:*",
    "@macrograph/plugin-json": "workspace:*",
    "@macrograph/plugin-kofi": "workspace:*",
    "@macrograph/plugin-list": "workspace:*",
    "@macrograph/plugin-logic": "workspace:*",
    "@macrograph/plugin-math": "workspace:*",
    "@macrograph/plugin-openai": "workspace:*",
    "@macrograph/plugin-string": "workspace:*",
    "@macrograph/plugin-twitch": "workspace:*",
    "@macrograph/plugin-utilities": "workspace:*",
    "@macrograph/project-host": "workspace:*",
    "alchemy": "2.0.0-beta.72",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare-rolldown-plugin": "^0.5.4",
    "@effect/vitest": "catalog:",
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "mprocs": "^0.9.6",
    "rolldown": "^1.0.1",
    "vite": "^8.0.7",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.21",
    "wrangler": "4.126.0"
  }
}
