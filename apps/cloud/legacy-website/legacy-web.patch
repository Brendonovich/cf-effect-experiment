--- /dev/null
+++ b/packages/base-packages/src/engines.browser.test.ts
@@ -0,0 +1,44 @@
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+import { build } from "vite";
+import { expect, it } from "vitest";
+
+it("bundles all browser engines without importing the Node server engine", async () => {
+	const entry = createRequire(import.meta.url).resolve(
+		"@macrograph/base-packages/engines/browser",
+	);
+	await build({
+		configFile: false,
+		root: fileURLToPath(new URL("..", import.meta.url)),
+		logLevel: "error",
+		plugins: [
+			{
+				name: "assert-browser-engine-boundary",
+				enforce: "pre",
+				resolveId(id) {
+					if (
+						id.startsWith("@effect/platform-node") ||
+						id.includes("/websocket-server/engine")
+					) {
+						this.error(`Node-only engine dependency in browser: ${id}`);
+					}
+				},
+				generateBundle() {
+					expect(this.getModuleInfo(entry)?.exports).toEqual(["default"]);
+					const modules = [...this.getModuleIds()];
+					for (const engine of [
+						"obs/new-engine",
+						"twitch/engine",
+						"util/engine",
+						"websocket-client/engine",
+					]) {
+						expect(modules).toContain(
+							fileURLToPath(new URL(`./${engine}.ts`, import.meta.url)),
+						);
+					}
+				},
+			},
+		],
+		build: { write: false, minify: false, lib: { entry, formats: ["es"] } },
+	});
+}, 30_000);
