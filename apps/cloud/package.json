{
  "name": "cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy": "pnpm exec node --experimental-transform-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env node_modules/alchemy/bin/alchemy.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate-accounts": "bash scripts/migrate-account-data.sh",
    "dev": "mprocs --names Alchemy,Frontend \"pnpm alchemy dev\" \"node --env-file-if-exists=.env dev-tunnel.ts\"",
    "deploy": "pnpm alchemy deploy",
    "test": "vp test run"
  },
  "dependencies": {
    "@alchemy.run/axiom": "2.0.0-beta.84",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/drizzle": "2.0.0-beta.84",
    "@alchemy.run/github": "2.0.0-beta.84",
    "@alchemy.run/planetscale": "2.0.0-beta.84",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-d1": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@effect/sql-sqlite-do": "4.0.6",
    "@macrograph/cloud-api": "workspace:*",
    "@macrograph/core": "workspace:*",
    "@macrograph/editor": "workspace:*",
    "@macrograph/execution": "workspace:*",
    "@macrograph/http-ingress": "workspace:*",
    "@macrograph/module": "workspace:*",
    "@macrograph/module-discord": "workspace:*",
    "@macrograph/module-elevenlabs": "workspace:*",
    "@macrograph/module-github": "workspace:*",
    "@macrograph/module-http-client": "workspace:*",
    "@macrograph/module-json": "workspace:*",
    "@macrograph/module-kofi": "workspace:*",
    "@macrograph/module-list": "workspace:*",
    "@macrograph/module-logic": "workspace:*",
    "@macrograph/module-math": "workspace:*",
    "@macrograph/module-openai": "workspace:*",
    "@macrograph/module-opencode": "workspace:*",
    "@macrograph/module-sendblue": "workspace:*",
    "@macrograph/module-string": "workspace:*",
    "@macrograph/module-twitch": "workspace:*",
    "@macrograph/module-utilities": "workspace:*",
    "@macrograph/opencode-workerd": "workspace:*",
    "@macrograph/persistence": "workspace:*",
    "@macrograph/persistence-sqlite": "workspace:*",
    "@macrograph/planetscale-logical-db": "workspace:*",
    "@macrograph/project-api": "workspace:*",
    "@macrograph/project-host": "workspace:*",
    "@macrograph/workflow-runtime": "workspace:*",
    "@macrograph/workflow-runtime-cloudflare": "workspace:*",
    "@noble/hashes": "2.4.0",
    "alchemy": "2.0.0-beta.84",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare-rolldown-plugin": "^0.5.4",
    "@effect/vitest": "catalog:",
    "@types/node": "^24",
    "drizzle-kit": "1.0.0-rc.5",
    "mprocs": "^0.9.6",
    "rolldown": "^1.0.1",
    "vite": "^8.0.7",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.21",
