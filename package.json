{
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"packages/modules/*",
			"apps/*",
			"apps/cloudflare/frontend",
			"apps/server/client"
		],
		"catalog": {
			"@stylexjs/stylex": "0.19.0",
			"@stylexjs/unplugin": "0.19.0",
			"effect": "4.0.0-beta.107",
			"@effect/opentelemetry": "4.0.0-beta.107",
			"@effect/platform-browser": "4.0.0-beta.107",
			"@effect/platform-bun": "4.0.0-beta.107",
			"@effect/platform-node": "4.0.0-beta.107",
			"@effect/platform-node-shared": "4.0.0-beta.107",
			"@effect/vitest": "4.0.0-beta.107"
		}
	},
	"type": "module",
	"scripts": {
		"build": "tsgo --build",
		"typecheck": "tsgo -b",
		"storybook": "pnpm --filter @macrograph/storybook dev",
		"storybook:build": "pnpm --filter @macrograph/storybook build",
		"clean": "pnpm -r clean",
		"format": "vp fmt . --write"
	},
	"devDependencies": {
		"@brendonovich/vite-plugin-opencode": "^0.1.0",
		"@typescript/native-preview": "7.0.0-dev.20260514.1",
		"typescript": "^5.8",
		"vite": "^8.0.7",
		"vite-plus": "^0.1.21"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.2.1"
}
